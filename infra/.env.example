# Sao chép thành .env rồi đổi mật khẩu:  cp .env.example .env
# KHÔNG commit file .env lên Git.

# ---------- MinIO / S3 (lake) ----------
MINIO_ROOT_USER=gpsadmin
MINIO_ROOT_PASSWORD=change-me-please
# Spark và boto3 đọc thông tin đăng nhập S3 từ các biến AWS_* (đặt giống MinIO)
AWS_ACCESS_KEY_ID=gpsadmin
AWS_SECRET_ACCESS_KEY=change-me-please
AWS_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
LAKE_BUCKET=gps

# ---------- Spark ----------
# Tài nguyên của MỖI worker (nhân bản bằng --scale spark-worker=N)
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=3g
SPARK_WORKER_CONTAINER_MEM=4g

# ---------- Kafka ----------
# Chuỗi base64 22 ký tự, giữ cố định sau lần chạy đầu
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_RAW_PARTITIONS=6

# ---------- Elasticsearch ----------
ES_JAVA_OPTS="-Xms1g -Xmx1g"

# ---------- Airflow ----------
# Trên Linux đặt bằng kết quả lệnh `id -u` để tránh lỗi quyền file
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_SECRET_KEY=change-me-too
